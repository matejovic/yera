{
  "manifest_version": 3,
  "name": "Yera — Knowledge Base & Web Clipper",
  "version": "1.0.0",
  "description": "Save, annotate, and organize web articles, notes, and highlights offline-first.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Yera"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "clipper@yera.app",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ]
}
